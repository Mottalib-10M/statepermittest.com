---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/permit-test-en/" title="Permit practice test" width="100%" height="820" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the free permit practice test on your website" description="Put the free permit practice test on your website: one iframe, every state, car, motorcycle and CDL questions with explained answers, no sign-up, no tracking, no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the permit practice test</h1>
    <p class="mt-3 text-lg text-navy-700">For a driving school, a high school, a library or a community center: visitors pick their state and take a practice test scored against that state's pass mark.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the test visible and use it as it is, without warranty. When a state changes its rules, the embedded test updates itself.</p>
    <p>Nothing your visitors answer reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/permit-test-en/" title="Permit practice test" width="100%" height="820" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
